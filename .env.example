# ==========================================
# CONFIGURAÇÕES DE REDE E PORTA
# ==========================================
# Rede e IPs Estáticos
SUBNET_IP=172.20.0.0/16
DB_STATIC_IP=172.20.0.2
WP_STATIC_IP=172.20.0.3
PMA_STATIC_IP=172.20.0.4
CODE_STATIC_IP=172.20.0.5

# Portas de Acesso Externo
WP_PORT=8080
PMA_PORT=8081
DB_PORT=8082
CODE_PORT=8083

# ==========================================
# SENHA DO VS CODE SERVER
# ==========================================
# Mude para uma senha segura
CODE_PASSWORD=sua_senha_segura

# ==========================================
# BANCO DE DADOS (MARIADB)
# ==========================================
MYSQL_DATABASE=asbc
MYSQL_USER=suporte
MYSQL_PASSWORD=sua_senha_segura
MYSQL_ROOT_PASSWORD=sua_senha_segura

# Chaves de Segurança e Sal do WordPress... (Mantenha as suas chaves intactas abaixo desta linha)
# Chaves de Segurança e Sal do WordPress (Security Keys / Salts)
# Gere chaves únicas em: https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY='sua_senha_segura'
WORDPRESS_SECURE_AUTH_KEY='sua_senha_segura'
WORDPRESS_LOGGED_IN_KEY='sua_senha_segura'
WORDPRESS_NONCE_KEY='sua_senha_segura'
WORDPRESS_AUTH_SALT='sua_senha_segura'
WORDPRESS_SECURE_AUTH_SALT='sua_senha_segura'
WORDPRESS_LOGGED_IN_SALT='sua_senha_segura'
WORDPRESS_NONCE_SALT='sua_senha_segura'
